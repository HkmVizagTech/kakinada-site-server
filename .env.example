# ─────────────────────────────────────────────────────────────────────────────
# ISKCON Kakinada — SERVER env template
#
# Copy to `.env` for local dev, or set these as Railway service Variables.
# NEVER put real secrets in this file — it is committed to git.
#
# Legend: [REQUIRED] = app breaks / feature is dead without it
#         [OPTIONAL] = has a code-level default
# ─────────────────────────────────────────────────────────────────────────────

# ── Platform (set automatically by Railway — do NOT set manually) ──────────
# PORT
# NODE_ENV=production

# ── Core ───────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string.
# On Railway this is injected AUTOMATICALLY by the Postgres plugin once you
# attach it to this service -- you do not set it by hand, and you must never
# paste a production URL into this file.
# Locally, either use a local Postgres or point it at a throwaway database:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kkd?schema=public"
DATABASE_URL=
# [REQUIRED] Secret used to sign admin JWTs. There is deliberately no fallback:
# the app throws rather than sign tokens with a guessable default. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# [REQUIRED] Public client origin. Drives the CORS allowlist AND the Meta CAPI
# event_source_url. Apex + www are both hardcoded in app.js as a fallback, so a
# wrong value here only breaks other origins / the Meta event URL.
FRONTEND_URL=https://iskconkakinada.org
# [REQUIRED for the internal cron route] Shared secret for
# GET /api/internal/send-pending-reminders, which triggers outbound WhatsApp
# messages. Sent as the `x-internal-secret` header. Unset = that route always
# answers 401, which is the safe default. Generate the same way as JWT_SECRET.
INTERNAL_SECRET=
# [OPTIONAL] Redis, for the payment job queue. Without it the queue degrades to
# in-process. Unreachable Redis is not fatal -- it rejects within ~2s and the
# webhook falls back to inline processing.
REDIS_URL=
# Leave UNSET in production. When "true" it logs auth headers/cookies.
DEBUG_AUTH=
# [OPTIONAL] "true" logs every Prisma query + params. Debugging only -- it
# will print donor emails, mobiles and payment IDs into the deploy logs.
PRISMA_LOG=
# [OPTIONAL] Milliseconds for in-flight requests to finish during shutdown.
SHUTDOWN_DRAIN_MS=3000

# ── First admin account (auto-seeded on boot) ──────────────────────────────
# [REQUIRED] Both must be set or the seed is skipped and you get no admin,
# i.e. nobody can log in at /admin/login. There is no default password.
# The password is re-synced on every boot, so rotating ADMIN_PASSWORD here
# does take effect on the next deploy.
ADMIN_EMAIL=
# [REQUIRED]
ADMIN_PASSWORD=
# [OPTIONAL]
ADMIN_NAME=ISKCON Kakinada Admin

# ── Razorpay — THREE separate accounts ─────────────────────────────────────
# [REQUIRED] "default" account — the main HKM/KKD account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# [OPTIONAL] falls back to the default account's secret
RAZORPAY_WEBHOOK_SECRET=
# [REQUIRED] "donations" account — used by sevas with account:"donations".
RAZORPAY_DONATIONS_KEY_ID=
RAZORPAY_DONATIONS_KEY_SECRET=
# [OPTIONAL] falls back to RAZORPAY_WEBHOOK_SECRET
RAZORPAY_DONATIONS_WEBHOOK_SECRET=
# [REQUIRED for Subhojanam] "touchstone" account — Touchstone Charities trust.
# Leave unset until this temple is live: checkout then returns a clear
# "not configured yet" error rather than misrouting funds to the wrong trust.
RAZORPAY_TOUCHSTONE_KEY_ID=
RAZORPAY_TOUCHSTONE_KEY_SECRET=
RAZORPAY_TOUCHSTONE_WEBHOOK_SECRET=
# [OPTIONAL] Subscription count for recurring monthly plans.
SUBSCRIPTION_TOTAL_COUNT=120

# ── DCC — Digital Contribution Certificate receipts ────────────────────────
# [REQUIRED] Without the API key, no DCC receipt is issued (donations still succeed).
DCC_API_KEY=
# [OPTIONAL] defaults to the Surabhi endpoint
DCC_API_URL=https://vhkmsurabhi.com/api/socialmedia/addDonation
DCC_ACCOUNT_TYPE=
# enrolledBy IDs — which DCC "cash counter" each donation is booked against.
# 36 is a shared devotee counter that the Vizag, Kakinada and Rajahmundry
# sites all currently book against, so 36 is a deliberate shared value here
# rather than a Kakinada-specific one. It is shipped explicitly instead of
# being left to the code fallback so the choice is visible in the config.
# Re-check these if DCC ever renumbers or issues a counter per site.
# [OPTIONAL] used for every donation whose site is "kakinada"
DCC_ENROLLED_BY_KAKINADA=36
# [OPTIONAL] generic override, consulted by every branch below
DCC_ENROLLED_BY=
# [OPTIONAL] REST-venue donations (falls back to the same 36)
DCC_ENROLLED_BY_REST=
# [OPTIONAL] per-donation overrides. Note the special/festival branch defaults
# to 25, not 36 -- set these if festival donations should book to 36 too.
DCC_ENROLLED_BY_DEFAULT=
DCC_ENROLLED_BY_SPECIAL=
DCC_ENROLLED_BY_DONATIONS_AND_JANMASHTAMI=
# [OPTIONAL] payment-mode codes (code defaults shown)
DCC_MODE_ONLINE=3
DCC_MODE_CASH=1
DCC_MODE_CHEQUE=2
DCC_MODE_UPI=3
DCC_MODE_BANK=4
# [OPTIONAL] seva taxonomy IDs (code defaults shown)
DCC_SEVA_CATEGORY=24
DCC_SEVA_SUBCATEGORY=115
DCC_SEVA_SUBCATEGORY_CODE=
# [OPTIONAL] JSON array of per-seva overrides, e.g.
#   [{"sevaNameIncludes":["Annadan"],"sevaCategory":31,"sevaSubCategory":118}]
# Must be valid JSON on ONE line -- a parse failure is logged and ignored, so
# a typo here silently falls back to DCC_SEVA_CATEGORY/SUBCATEGORY.
DCC_SEVA_MAPPINGS=

# ── Meta (Facebook) ────────────────────────────────────────────────────────
# Must match NEXT_PUBLIC_META_PIXEL_ID on the client or Meta rejects the
# server event as a duplicate/mismatch and dedup silently fails.
META_PIXEL_ID=
# [REQUIRED for CAPI] from Events Manager → Conversions API
META_CAPI_ACCESS_TOKEN=
# [OPTIONAL] only while testing in the Events Manager Test Events tab
META_TEST_EVENT_CODE=

# ── Cloudflare R2 (media uploads + hosted receipt PDFs) ─────────────────────
# An unset R2_ACCOUNT_ID makes uploads die with a confusing SSL handshake
# error rather than a clear message, so set these together.
# Same Cloudflare account as the Rajahmundry project -- only the bucket differs.
# Keys come from the bucket's R2 API Tokens page.
R2_ACCOUNT_ID=36157874c7be2bd1b67c837b65e8b034
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=iskcon-kkd
# [REQUIRED for receipt PDFs] Public base URL of THIS bucket's r2.dev domain.
# Receipt PDFs are uploaded here and the Gupshup template links to them, so
# leaving this blank means donors get a template whose PDF link does not
# resolve. Copy it from the R2 bucket's Public Development URL.
#
# This is the iskcon-kkd bucket, which is a DIFFERENT r2.dev host from
# Rajahmundry's iskcon-rjy bucket. The two share one Cloudflare account but
# each bucket has its own subdomain, so copying the value from the RJY
# .env.example would upload Kakinada's donor receipts into Rajahmundry's
# bucket. The hostnames are also asserted in each client's next.config.ts.
R2_PUBLIC_URL=https://pub-a141ba4729a546b29a5015432b31bd23.r2.dev

# ── WhatsApp — Gupshup (the ACTIVE provider) ───────────────────────────────
# Which BSP sends each kind of message. Both are read fresh on every send
# (not cached at module load), so changing them is a live rollback switch that
# takes effect without a redeploy. Valid: "gupshup" | "flaxxa" | "wapi".
# [OPTIONAL] receipt PDF on a completed donation
RECEIPT_WHATSAPP_PROVIDER=gupshup
# [OPTIONAL] abandoned-checkout reminder
PENDING_WHATSAPP_PROVIDER=gupshup
# [REQUIRED] Without API key + app name, WhatsApp is skipped entirely and
# donations still complete -- silently, with no receipt to the donor.
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
# [OPTIONAL] Gupshup API credentials. From the Gupshup dashboard.
GUPSHUP_SOURCE_NUMBER=917075176108
# [OPTIONAL] Approved template UUIDs. The defaults are Vizag's approved
# templates. The pending template's button points at
# https://www.harekrishnavizag.org/<link> -- the Kakinada code detects that
# mismatch, writes the correct link into the message body instead, and logs a
# warning at boot. Get Kakinada its own approved template and set both
# GUPSHUP_PENDING_TEMPLATE_ID and GUPSHUP_PENDING_BUTTON_BASE to silence it.
GUPSHUP_PENDING_TEMPLATE_ID=f12a709c-bc1f-429b-84d5-1262bc01a73c
GUPSHUP_PENDING_BUTTON_BASE=https://www.harekrishnavizag.org
GUPSHUP_RECEIPT_TEMPLATE_ID=1c953ac3-3856-4b9d-b4ab-f52f98ba2564
# [OPTIONAL] "true" appends the button param (default), "false" omits it
GUPSHUP_PENDING_BUTTON_PARAM=true
# [OPTIONAL] Banner used when a seva banner can't be converted to JPEG.
GUPSHUP_FALLBACK_HEADER_IMAGE=
# [OPTIONAL] Shared secret in the webhook PATH for POST /webhooks/whatsapp.
# Gupshup's self-serve callbacks carry no signature, so this is what stops
# strangers from injecting fake delivery receipts.
GUPSHUP_WEBHOOK_SECRET=
# [OPTIONAL] Salt for the public receipt-PDF filename. Set your own random
# value: the shipped default is public in the source, and anyone who knows it
# can derive the filename of any donation's receipt URL. Changing it later
# just orphans the old files -- they keep working, nothing breaks.
RECEIPT_URL_SALT=kkd-receipt

# ── WhatsApp — WAPI / Flaxxa (LEGACY fallback, inactive by default) ────────
# Only consulted when RECEIPT_WHATSAPP_PROVIDER or PENDING_WHATSAPP_PROVIDER
# is set to "wapi"/"flaxxa". Leave empty otherwise.
WAPI_TOKEN=
WAPI_RECEIPT_TEMPLATE_NAME=common_donation_success_reciept
WAPI_PENDING_TEMPLATE_NAME=pending_seva_notice
WAPI_TEMPLATE_LANG=en

# ── Pending-transaction reminders ──────────────────────────────────────────
# An in-process scheduler runs these in index.js. Turn it off with
# PENDING_REMINDER_ENABLED=false if you drive them from an external cron
# against /api/internal/send-pending-reminders instead.
# [OPTIONAL] "false" disables the in-process scheduler
PENDING_REMINDER_ENABLED=true
PENDING_REMINDER_INTERVAL_MINUTES=10
# Only remind about donations older than this, so a donor who is still on the
# payment page is not nagged.
PENDING_REMINDER_CUTOFF_MINUTES=6
# Stop reminding about anything older than this.
PENDING_REMINDER_MAX_AGE_HOURS=24
PENDING_REMINDER_BATCH_SIZE=100
# Give up (and stop retrying) after this many failed attempts per donation.
PENDING_REMINDER_MAX_ATTEMPTS=3
# Comma-separated donation statuses eligible for a reminder.
PENDING_REMINDER_STATUSES=pending,failed
# Skip a donor who already completed a donation this recently.
PENDING_REMINDER_SKIP_IF_COMPLETED_WITHIN_MINUTES=15
# [OPTIONAL] "false" puts no deep link in the message
PENDING_DEEP_LINK=true
# [OPTIONAL] Truncate donor/seva text to this many chars (template limits).
PENDING_MAX_SEVA_FIELD_LENGTH=120
# [OPTIONAL] JSON, { "<sourcePage>": "<banner url>" } -- per-page seva banners.
# Must be JSON on ONE line; a parse failure is logged and ignored.
PENDING_REMINDER_SEVA_IMAGES=
# [OPTIONAL] JSON, { "<festivalSlug>": "<label>" } -- friendlier campaign names
# than the auto-prettified slug.
PENDING_REMINDER_CAMPAIGN_LABELS=
# [OPTIONAL] Banner when no per-page image matches.
PENDING_REMINDER_DEFAULT_IMAGE=
# [OPTIONAL] Comma-separated pages that should get a deep link.
PENDING_REMINDER_DEEP_LINK_PAGES=

# ── Blog proxy ─────────────────────────────────────────────────────────────
# [OPTIONAL] Upstream server this site proxies /blogs-proxy through.
# INTENTIONALLY the Vizag host: both this site and Rajahmundry show their
# blogs from Vizag. It is a read-only blog feed, so nothing else is shared.
# It is also the ONLY source of blog content here, which makes it a single
# point of failure — the BLOG_CACHE_* settings below are what stop a Vizag
# outage from taking the blog section down with it.
# Clear it to disable the proxy if you would rather have no upstream at all.
VIZAG_API_URL=https://hkmsite20-server-production.up.railway.app
# [OPTIONAL] how long a cached proxy response is served before re-fetching.
# Posts change a few times a week, so minutes-old content is fine.
BLOG_CACHE_TTL_SECONDS=300
# [OPTIONAL] during an upstream outage, how old a cached copy may still be
# served before the proxy gives up and returns a 502. Generous on purpose —
# the alternative is a blank blog section.
BLOG_CACHE_STALE_HOURS=24
# [OPTIONAL] ceiling on cached entries, so a crawler walking thousands of slugs
# cannot grow the in-process cache without bound. Oldest entry is evicted first.
BLOG_CACHE_MAX_ENTRIES=300

# ── PDF receipts ───────────────────────────────────────────────────────────
# [OPTIONAL] Telugu font for receipt PDFs. Falls back to the bundled
# assets/fonts/NotoSansTelugu-Regular.ttf, then to built-in Helvetica -- and
# Helvetica cannot render Telugu, so donor names in Telugu get stripped from
# the PDF. Only set this to override the bundled font.
RECEIPT_FONT_PATH=
